{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "BankingAPI": "Debug"
    }
  },
  "AllowedHosts": "*",
  "DataFiles": {
    "AccountsPath": "Data/accounts.json",
    "TransactionsPath": "Data/transactions.json"
  },
  "PaymentLimits": {
    "UPI": {
      "MaxPerTransaction": 100000,
      "MaxPerDay": 500000
    },
    "NEFT": {
      "MaxPerTransaction": 10000000
    },
    "CreditCard": {
      "MaxPerTransaction": 500000,
      "ProcessingFeePercentage": 2.5
    }
  }
}